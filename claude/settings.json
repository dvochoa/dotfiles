{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit(**)",
      "Read(**)",
      "Read(~/Desktop/*.png)",
      "Read(~/Downloads/*.png)",
      "Read(~/Desktop/*.jpg)",
      "Read(~/Downloads/*.jpg)",
      "Read(~/.claude/**)",
      "WebSearch",
      "WebFetch",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(source:*)",
      "Bash(which:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(pwd:*)",
      "Bash(date:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(file:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(mvn:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)"
    ],
    "deny": [
      "Read(./.env**)",
      "Read(./secrets/**)"
    ],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Desktop/Work"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "find-skills": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/danny/dotfiles/agents/hooks/notify.sh",
            "statusMessage": "Sending completion notification..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/danny/dotfiles/agents/hooks/notify.sh",
            "statusMessage": "Sending notification..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/danny/dotfiles/claude/hooks/load_nvm.sh",
            "statusMessage": "Loading nvm environment..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/danny/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
