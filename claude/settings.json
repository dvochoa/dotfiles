      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Plugin:playwright:browser_navigate_back",
      "Plugin:playwright:browser_close",
      "Plugin:playwright:browser_resize",
      "Plugin:playwright:browser_tabs",
      "Plugin:playwright:browser_console_messages",
      "Plugin:playwright:browser_network_requests",
      "Plugin:playwright:browser_snapshot",
      "Plugin:playwright:browser_take_screenshot",
      "Plugin:playwright:browser_click",
      "Plugin:playwright:browser_type",
      "Plugin:playwright:browser_press_key",
      "Plugin:playwright:browser_hover",
