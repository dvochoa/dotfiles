      "Plugin:next-devtools:nextjs_call"
    ],
    "deny": [
      "Read(./.env**)",
      "Read(./secrets/**)"
    ],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Desktop/Work"
    ]
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "next-devtools"
  ],
  "skillOverrides": {
    "find-skills": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/danny/dotfiles/agents/hooks/notify.sh",
            "statusMessage": "Sending completion notification..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/danny/dotfiles/agents/hooks/notify.sh",
            "statusMessage": "Sending notification..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/danny/dotfiles/claude/hooks/load_nvm.sh",
            "statusMessage": "Loading nvm environment..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/danny/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: AWS (S3 for photos via CloudFront; App Runner/ECS Fargate, RDS per README) — this repo only",
